+            std::fill(owners_.begin(), owners_.end(), -1);
+            for (size_t i = 0; i < selected_.size(); ++i) add(static_cast<int>(i));
+        }
+        check();
+    }
+
+    const ActionSequence& path(int robot) const { return choices_[robot][selected_[robot]]; }
+    int selected(int robot) const { return selected_[robot]; }
+    long long attempts = 0, improvements = 0, explorations = 0, rollbacks = 0, candidates = 0, displacements = 0;
+
+private:
+    bool accept_delta(int64_t change) {
+        const bool accepted = change < 0 || (temperature_ > 0 &&
+            std::generate_canonical<double, 32>(random_) < std::exp(-double(change) / temperature_));
+        if (accepted) last_delta_ = change;
+        return accepted;
+    }
+    bool unchanged(const ActionSequence& a, const ActionSequence& b) const {
+        return a.cells == b.cells && a.orientations == b.orientations;
+    }
+    // -1: free, -2: multiple distinct blockers; otherwise a single robot.
+    int conflict(const ActionSequence& path) const {
+        int blocker = -1;
+        auto observe = [&](int robot) {
+            if (robot < 0) return true;
+            if (blocker >= 0 && blocker != robot) return false;
+            blocker = robot; return true;
+        };
+        for (int t = 1; t <= horizon_; ++t) {
+            const int from = path.cells[t - 1], to = path.cells[t];
+            if (from < 0 || to < 0 || from >= cells_ || to >= cells_)
+                throw std::logic_error("action-sequence cell outside the map");
+            if (!observe(owners_[(t - 1) * cells_ + to])) return -2;
+            if (from != to) {
+                const int other = owners_[(t - 1) * cells_ + from];
+                if (other >= 0 && this->path(other).cells[t - 1] == to && !observe(other)) return -2;
+            }
+        }
+        return blocker;
+    }
+    void add(int robot) {
+        const auto& p = path(robot);
+        for (int t = 1; t <= horizon_; ++t) {
+            int& owner = owners_[(t - 1) * cells_ + p.cells[t]];
+            if (owner >= 0) throw std::logic_error("duplicate sequence reservation");
+            owner = robot;
+        }
+    }
+    void remove(int robot) {
+        const auto& p = path(robot);
+        for (int t = 1; t <= horizon_; ++t) {
+            int& owner = owners_[(t - 1) * cells_ + p.cells[t]];
+            if (owner != robot) throw std::logic_error("missing sequence reservation");
+            owner = -1;
+        }
+    }
+    template<class Check>
+    bool repair(int robot, int depth, int& budget, int64_t delta, Check& check) {
+        visiting_[robot] = true;
+        const int old = selected_[robot];
+        const int64_t old_cost = path(robot).cost;
+        for (int choice : ordered_[robot]) {
+            if (budget-- <= 0) break;
+            ++candidates;
+            if ((candidates & 63) == 0) check();
+            const auto& candidate = choices_[robot][choice];
+            if (base_temperature_ && unchanged(candidate, choices_[robot][old])) continue;
+            const int other = conflict(candidate);
+            if (other == -2 || (other >= 0 && (depth == max_depth_ || fixed_[other] || visiting_[other]))) continue;
+            const int64_t change = delta + candidate.cost - old_cost;
+            if (other < 0) {
+                if (!accept_delta(change)) continue;
+                selected_[robot] = choice; add(robot);
+                visiting_[robot] = false; return true;
+            }
+            remove(other);
+            selected_[robot] = choice; add(robot);
+            ++displacements;
+            if (repair(other, depth + 1, budget, change, check)) {
+                visiting_[robot] = false; return true;
+            }
+            remove(robot); selected_[robot] = old;
+            add(other);
+        }
+        selected_[robot] = old;
+        visiting_[robot] = false;
+        return false;
+    }
+    // Return all conflicting robots, up to the configured fixed fan-out. Paths
+    // already chosen in this repair are protected; pending paths are unreserved.
+    int blockers(const ActionSequence& path, std::array<int, 3>& result) const {
+        int count = 0;
+        auto observe = [&](int robot) {
+            if (robot < 0) return true;
+            if (fixed_[robot] || visiting_[robot]) return false;
+            for (int k = 0; k < count; ++k) if (result[k] == robot) return true;
+            if (count == max_blockers_) return false;
+            result[count++] = robot; return true;
+        };
+        for (int t = 1; t <= horizon_; ++t) {
+            const int from = path.cells[t - 1], to = path.cells[t];
+            if (from < 0 || to < 0 || from >= cells_ || to >= cells_)
+                throw std::logic_error("action-sequence cell outside the map");
+            if (!observe(owners_[(t - 1) * cells_ + to])) return -1;
+            if (from != to) {
+                const int other = owners_[(t - 1) * cells_ + from];
+                if (other >= 0 && this->path(other).cells[t - 1] == to && !observe(other)) return -1;
+            }
+        }
+        return count;
+    }
+
+    // On entry, robot and pending have no reservations. On failure every selected
+    // path and reservation is restored to exactly that state. On success all
+    // pending robots are placed and the COMPLETE joint cost is strictly lower.
+    template<class Check>
+    bool repair_many(int robot, std::array<int, 16> pending, int pending_count, int depth,
+                     int& budget, int64_t delta, Check& check) {
+        visiting_[robot] = true;
+        const int old = selected_[robot];
+        const int64_t old_cost = path(robot).cost;
+        for (int choice : ordered_[robot]) {
+            if (budget-- <= 0) break;
