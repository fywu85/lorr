+            const int count = blockers(candidate, displaced);
+            if (count < 0 || depth + pending_count + count > max_depth_) continue;
+            auto next_pending = pending;
+            int next_count = pending_count;
+            for (int k = 0; k < count; ++k) {
+                remove(displaced[k]);
+                next_pending[next_count++] = displaced[k];
+            }
+            selected_[robot] = choice; add(robot);
+            const int64_t change = delta + candidate.cost - old_cost;
+            displacements += count;
+            const bool accepted = next_count == 0 ? accept_delta(change) :
+                repair_many(next_pending[next_count - 1], next_pending, next_count - 1,
+                            depth + 1, budget, change, check);
+            if (accepted) { visiting_[robot] = false; return true; }
+            remove(robot); selected_[robot] = old;
+            for (int k = 0; k < count; ++k) add(displaced[k]);
+        }
+        selected_[robot] = old;
+        visiting_[robot] = false;
+        return false;
+    }
+    int horizon_;
+    const std::vector<std::vector<ActionSequence>>& choices_;
+    const std::vector<char>& fixed_;
+    std::vector<int> selected_, owners_;
+    std::vector<char> visiting_;
+    int cells_;
+    int max_blockers_, candidate_budget_, max_depth_;
+    int base_temperature_ = 0, temperature_ = 0;
+    int64_t last_delta_ = 0;
+    std::mt19937 random_;
+    std::vector<std::vector<int>> ordered_;
+};
+
+}  // namespace cgar
