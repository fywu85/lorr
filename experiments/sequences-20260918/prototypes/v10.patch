+void action_sequence_stationary_turn() {
+ SharedEnvironment e;e.rows=3;e.cols=3;e.map.assign(9,0);e.num_of_agents=2;
+ e.curr_states={State(8,0,3),State(2,0,0)};e.goal_locations={{{2,0}},{{8,0}}};e.curr_task_schedule={0,1};
+ for(int i=0;i<2;++i){Task t;t.task_id=i;t.locations={i?8:2};e.task_pool.emplace(i,t);}
+ setenv("CGAR_SEQUENCE_HORIZON","5",1);setenv("CGAR_SEQUENCE_FREE_INTENTS","1",1);setenv("CGAR_SEQUENCE_INITIAL_WAIT","1",1);
+ unsetenv("CGAR_SEQUENCE_TURN_ONLY");Cgar old;old.initialize(&e,1000);std::vector<Action> before;old.plan(&e,1000,before);
+ setenv("CGAR_SEQUENCE_TURN_ONLY","1",1);Cgar planner;planner.initialize(&e,1000);std::vector<Action> after;planner.plan(&e,1000,after);
+ if(before[0]!=Action::FW||after!=std::vector<Action>({Action::FW,Action::CR})||
+    planner.proposed_cells()[1]!=2||old.proposed_cells()[1]==planner.proposed_cells()[1])
+  throw std::runtime_error("blocked robot did not prepare a stationary turn: before="+
+    std::to_string(static_cast<int>(before[1]))+" after="+std::to_string(static_cast<int>(after[1]))+
+    " old_target="+std::to_string(old.proposed_cells()[1])+" new_target="+std::to_string(planner.proposed_cells()[1]));
+ if(step(e,e.curr_states,after).empty())throw std::runtime_error("stationary turn changed reserved occupancy");
+ setenv("CGAR_SEQUENCE_TURN_ONLY","2",1);setenv("CGAR_SEQUENCE_BUDGET","1",1);
+ Cgar seeded;seeded.initialize(&e,1000);std::vector<Action> ready;seeded.plan(&e,1000,ready);
+ if(ready!=after||seeded.proposed_cells()[1]!=2||seeded.stats().sequence_candidates>1)
+  throw std::runtime_error("stationary seed depended on displacement search budget");
+ unsetenv("CGAR_SEQUENCE_BUDGET");
+ unsetenv("CGAR_SEQUENCE_HORIZON");unsetenv("CGAR_SEQUENCE_FREE_INTENTS");unsetenv("CGAR_SEQUENCE_INITIAL_WAIT");unsetenv("CGAR_SEQUENCE_TURN_ONLY");
+ std::cout<<"ACTION_SEQUENCE_STATIONARY_TURN passed blocked_forward=1 ready_orientation=1 primary_preserved=1\n";
+}
