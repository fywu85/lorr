+constexpr int kSequenceMaxHorizon = 5;
+struct ActionSequence {
+    std::array<int, kSequenceMaxHorizon + 1> cells{};
+    std::array<int, kSequenceMaxHorizon + 1> orientations{};
+    std::array<Action, kSequenceMaxHorizon> actions{};
+    int64_t cost = 0;
+};
+
+// Merge two feasible joint plans while keeping selected baseline paths. A
+// baseline path conflicting with a carried path forces that robot to baseline
+// too. Closing these implications preserves all unforced carried paths and is
+// linear in the fleet size and horizon; falling back to all baseline is valid.
+inline std::vector<char> close_sequence_overrides(
+    int cells, int horizon, const std::vector<ActionSequence>& baseline,
+    const std::vector<ActionSequence>& carried, std::vector<char> reset) {
+    if (cells < 1 || horizon < 1 || horizon > kSequenceMaxHorizon ||
+        baseline.size() != carried.size() || reset.size() != baseline.size())
+        throw std::invalid_argument("invalid sequence merge dimensions");
+    std::vector<int> owners(cells * horizon, -1), queue;
+    for (size_t i = 0; i < carried.size(); ++i) {
+        for (int t = 1; t <= horizon; ++t) {
+            const int v = carried[i].cells[t];
+            if (v < 0 || v >= cells || owners[(t - 1) * cells + v] >= 0)
+                throw std::logic_error("invalid carried sequence reservations");
+            owners[(t - 1) * cells + v] = static_cast<int>(i);
+        }
+        if (reset[i]) queue.push_back(static_cast<int>(i));
+    }
+    auto require = [&](int i) {
+        if (i >= 0 && !reset[i]) { reset[i] = true; queue.push_back(i); }
+    };
+    for (size_t head = 0; head < queue.size(); ++head) {
+        const auto& path = baseline[queue[head]];
+        for (int t = 1; t <= horizon; ++t) {
+            const int from = path.cells[t - 1], to = path.cells[t];
+            require(owners[(t - 1) * cells + to]);
+            if (from != to) {
+                const int other = owners[(t - 1) * cells + from];
+                if (other >= 0 && carried[other].cells[t - 1] == to) require(other);
+            }
+        }
+    }
+    return reset;
+}
+
+// Bounded displacement-chain search over COMPLETE, jointly feasible trajectories.
+// The initial trajectory for each robot is choice zero. A failed repair restores
+// every reservation. Greedy repairs lower summed cost; optional fixed exploratory
+// passes retain the cheapest complete plan at deterministic checkpoints.
+// Deadline checks are supplied by CGAR and throw, never accepting partial work.
+class ActionSequenceSearch {
+public:
+    ActionSequenceSearch(int cells, int horizon, const std::vector<std::vector<ActionSequence>>& choices,
+                         const std::vector<char>& fixed, int max_blockers = 1, int candidate_budget = 64, int max_depth = 4, int temperature = 0, uint32_t seed = 0)
+        : horizon_(horizon), choices_(choices), fixed_(fixed), selected_(choices.size(), 0),
+          owners_(cells * horizon, -1), visiting_(choices.size(), false), cells_(cells), max_blockers_(max_blockers),
+          candidate_budget_(candidate_budget), max_depth_(max_depth), base_temperature_(temperature), random_(seed) {
+        if (horizon < 1 || horizon > kSequenceMaxHorizon || choices.size() != fixed.size() ||
+            max_blockers < 1 || max_blockers > 3 || candidate_budget < 1 || max_depth < 0 || max_depth > 15)
+            throw std::invalid_argument("invalid action-sequence search dimensions");
+        for (size_t i = 0; i < choices.size(); ++i) {
+            if (choices[i].empty() || conflict(choices[i][0]) != -1)
+                throw std::logic_error("invalid initial joint action sequences");
+            add(static_cast<int>(i));
+        }
+        ordered_.resize(choices.size());
+        for (size_t i = 0; i < choices.size(); ++i) {
+            auto& ids = ordered_[i];
+            for (size_t k = 0; k < choices[i].size(); ++k) ids.push_back(static_cast<int>(k));
+            std::stable_sort(ids.begin(), ids.end(), [&](int a, int b) { return choices[i][a].cost < choices[i][b].cost; });
+        }
+    }
+
+    template<class Check>
+    void run(const std::vector<int>& order, int passes, Check check) {
+        int64_t total_cost = 0;
+        for (size_t i = 0; i < selected_.size(); ++i) total_cost += path(static_cast<int>(i)).cost;
+        int64_t best_cost = total_cost;
+        auto best = selected_;
+        auto checkpoint = [&] {
+            if (base_temperature_ && total_cost < best_cost) { best_cost = total_cost; best = selected_; }
+        };
+        for (int pass = 0; pass < passes; ++pass) {
+            // Prescribed work: greedy endpoints, fixed-temperature middle
+            // passes, deterministic checkpoints. Never stop on elapsed time.
+            temperature_ = pass > 0 && pass + 1 < passes ? base_temperature_ / pass : 0;
+            auto sweep = order;
+            if (temperature_) std::shuffle(sweep.begin(), sweep.end(), random_);
+            int roots = 0;
+            for (int robot : sweep) {
+                check();
+                if (fixed_[robot]) continue;
+                ++attempts;
+                remove(robot);
+                int budget = candidate_budget_;
+                const bool accepted = max_blockers_ == 1 ? repair(robot, 0, budget, 0, check) :
+                    repair_many(robot, {}, 0, 0, budget, 0, check);
+                if (accepted) {
+                    total_cost += last_delta_;
+                    if (last_delta_ < 0) ++improvements; else ++explorations;
+                } else { add(robot); ++rollbacks; }
+                if ((++roots & 127) == 0) checkpoint();
+            }
+            checkpoint();
+        }
+        if (base_temperature_) {
