+
+void Cgar::refine_action_sequences(std::vector<Action>& actions, const std::vector<int>& commitments) {
+    const int horizon = sequence_horizon_;
+    const auto baseline_actions = actions;
+    const auto baseline_targets = next_;
+    std::vector<char> fixed(n_, false), stationary_seed(n_, false), witness_cell(cert_.free.size(), false);
+    for (int cell : txn_cells_) witness_cell[cell] = true;
+    std::vector<std::vector<ActionSequence>> choices(n_);
+    // The many paths revisit the same handful of local states. Memoization is
+    // per robot and call; it neither builds tables nor changes their recency.
+    const size_t cell_count = cert_.free.size();
+    std::vector<int> spatial_cache(cell_count), spatial_stamp(cell_count, -1);
+    std::vector<int> heuristic_cache(cell_count * 4), heuristic_stamp(cell_count * 4, -1);
+    // Enumerate a generic action language: no reversed turns before a forward,
+    // at most a clockwise half-turn, and no unfinished turn at the horizon.
+    // Waits may occur anywhere. This is generated once, with no map-specific pool.
+    static const auto pools = [] {
+        std::array<std::vector<std::array<Action, kSequenceMaxHorizon>>, 6> result;
+        for (int h : {3, 5}) {
+            std::array<Action, kSequenceMaxHorizon> sequence{};
+            auto visit = [&](auto&& self, int t, int turn_sign, int turns) -> void {
+                if (t == h) {
+                    if (turns == 0) result[h].push_back(sequence);
+                    return;
+                }
+                for (Action a : {Action::FW, Action::CR, Action::CCR, Action::W}) {
+                    const int sign = a == Action::CR ? 1 : (a == Action::CCR ? -1 : 0);
+                    if (sign && (turns == 2 || (turn_sign && turn_sign != sign) || (sign == -1 && turns))) continue;
+                    sequence[t] = a;
+                    self(self, t + 1, a == Action::FW ? 0 : (sign ? sign : turn_sign),
+                         a == Action::FW ? 0 : turns + (sign != 0));
+                }
+            };
+            visit(visit, 0, 0, 0);
+            // A blocked robot may still prepare its orientation. These three
+            // paths occupy exactly the same cells as waiting for the horizon.
+            for (int kind = 0; kind < 3; ++kind) {
+                sequence.fill(Action::W);
+                sequence[0] = kind == 1 ? Action::CCR : Action::CR;
+                if (kind == 2) sequence[1] = Action::CR;
+                result[h].push_back(sequence);
+            }
+        }
+        return result;
+    }();
+    for (int i = 0; i < n_; ++i) {
+        const Agent& agent = agents_[i];
+        fixed[i] = i == primary_ || agent.in_txn || parked_[i] || agent.lock >= 0 ||
+                   !cert_.core[loc_[i]] || !cert_.core[baseline_targets[i]] ||
+                   witness_cell[loc_[i]] || (capacity_mode_ && !parking_ready_);
+        stats_.sequence_protected += fixed[i];
+    }
+    auto initial_actions = actions;
+    if (sequence_initial_wait_) {
+        // Waiting is feasible except where a protected forward move requires an
+        // existing occupant to vacate. Close that dependency chain using the
+        // already validated baseline, then keep exactly those initial actions.
+        std::vector<char> keep = fixed;
+        std::vector<int> queue;
+        for (int i = 0; i < n_; ++i) if (keep[i]) queue.push_back(i);
+        for (size_t head = 0; head < queue.size(); ++head) {
+            const int i = queue[head];
+            if (actions[i] != Action::FW) continue;
+            const int to = sequence_neighbors_[loc_[i]][ori_[i]];
+            const int other = occ_now_[to];
+            if (other >= 0 && !keep[other]) { keep[other] = true; queue.push_back(other); }
+        }
+        for (int i = 0; i < n_; ++i) if (!keep[i]) initial_actions[i] = Action::W;
+    }
+    std::vector<ActionSequence> initial_paths(n_);
+    for (int i = 0; i < n_; ++i) {
+        auto& path = initial_paths[i];
+        path.cells[0] = loc_[i]; path.orientations[0] = ori_[i];
+        for (int t = 1; t <= horizon; ++t) {
+            Action a = t == 1 ? initial_actions[i] : Action::W;
+            path.actions[t - 1] = a;
+            path.cells[t] = a == Action::FW ? sequence_neighbors_[path.cells[t - 1]][path.orientations[t - 1]] : path.cells[t - 1];
+            path.orientations[t] = (path.orientations[t - 1] + (a == Action::CR ? 1 : a == Action::CCR ? 3 : 0)) % 4;
+        }
+    }
+    bool carry_ready = sequence_carry_ && sequence_last_step_ + 1 == env_->curr_timestep &&
+                       sequence_previous_.size() == static_cast<size_t>(n_);
+    if (carry_ready) for (int i = 0; i < n_; ++i)
+        carry_ready &= sequence_previous_[i].cells[1] == loc_[i] && sequence_previous_[i].orientations[1] == ori_[i];
+    if (carry_ready) {
+        std::vector<ActionSequence> carried(n_);
+        auto reset = fixed;
+        for (int i = 0; i < n_; ++i) {
+            const auto& old = sequence_previous_[i]; auto& path = carried[i];
+            for (int t = 0; t < horizon; ++t) {
+                path.cells[t] = old.cells[t + 1]; path.orientations[t] = old.orientations[t + 1];
+                path.actions[t] = t + 1 < horizon ? old.actions[t + 1] : Action::W;
+            }
+            path.cells[horizon] = old.cells[horizon]; path.orientations[horizon] = old.orientations[horizon];
+            for (int t = 1; t <= horizon; ++t)
+                reset[i] = reset[i] || !cert_.core[path.cells[t]] || !allowed(i, path.cells[t]) || witness_cell[path.cells[t]];
+        }
+        reset = close_sequence_overrides(static_cast<int>(cell_count), horizon, initial_paths, carried, std::move(reset));
+        for (int i = 0; i < n_; ++i) {
+            stats_.sequence_reset_paths += reset[i];
+            if (!reset[i]) initial_paths[i] = carried[i];
+        }
+        ++stats_.sequence_warm_calls;
+    }
+    for (int i = 0; i < n_; ++i) {
+        check_deadline(deadline_, "sequence_candidates");
+        const Agent& agent = agents_[i];
+        const auto* distance = agent.goal >= 0 ? oracle_.peek(agent.goal) : nullptr;
+        auto spatial = [&](int cell) {
+            if (agent.goal < 0) return 0;
+            if (spatial_stamp[cell] != i) {
+                spatial_stamp[cell] = i;
+                spatial_cache[cell] = distance ? oracle_.value(*distance, cell) : oracle_.manhattan(cell, agent.goal);
+            }
+            return spatial_cache[cell];
+        };
+        const auto* oriented = orientation_guidance_ && agent.goal >= 0 ? turn_oracle_.peek(agent.goal) : nullptr;
+        stats_.sequence_oriented += oriented != nullptr;
+        auto heuristic = [&](int cell, int orientation) {
+            if (oriented) {
+                const int exact = turn_oracle_.value(*oriented, cell, orientation);
+                if (exact < kInf) return exact;
+            }
+            const int state = cell * 4 + orientation;
+            if (heuristic_stamp[state] == i) return heuristic_cache[state];
+            heuristic_stamp[state] = i;
+            int h = spatial(cell);
+            if (h <= 0 || h >= kInf) return heuristic_cache[state] = h;
+            int turns = 2;
+            for (int d = 0; d < 4; ++d) {
+                int v = sequence_neighbors_[cell][d];
+                if (v < 0 || !cert_.free[v] || spatial(v) >= h) continue;
+                int delta = (d - orientation + 4) % 4;
+                turns = std::min(turns, delta == 3 ? 1 : delta);
+            }
+            return heuristic_cache[state] = h + turns;
+        };
+        auto score = [&](ActionSequence& path) {
+            // Terminal action distance dominates; the integral favors progress
+            // earlier in the horizon. Equal-progress detours/turns have a cost.
+            path.cost = int64_t(100) * heuristic(path.cells[horizon], path.orientations[horizon]);
+            for (int t = 1; t <= horizon; ++t)
+                path.cost += int64_t(5) * spatial(path.cells[t]) + (path.actions[t - 1] != Action::W);
+        };
+        ActionSequence baseline = initial_paths[i];
+        bool stationary = true;
+        for (int t = 1; t <= horizon; ++t) stationary &= baseline.cells[t] == loc_[i];
+        score(baseline); choices[i].push_back(baseline);
+        if (fixed[i]) continue;
+        const auto& pool = pools[horizon];
+        const size_t count = pool.size() - (sequence_turn_only_ ? 0 : 3);
+        for (size_t k = 0; k < count; ++k) {
+            const auto& sequence = pool[k];
+            ActionSequence path;
+            path.cells[0] = loc_[i]; path.orientations[0] = ori_[i]; path.actions = sequence;
+            bool valid = true;
+            int commitment = commitments[i];
+            for (int t = 1; t <= horizon; ++t) {
+                const int cell = path.cells[t - 1], orientation = path.orientations[t - 1];
+                const Action a = sequence[t - 1];
+                // Existing useful first actions are protected. A blocked wait
+                // may become a move only toward its existing committed cell.
+                if (t == 1 && commitment >= 0 && actions[i] != Action::W && a != actions[i]) { valid = false; break; }
+                if (commitment >= 0 && a != Action::W) {
+                    int d = direction(cell, commitment, cert_.cols);
+                    int delta = (d - orientation + 4) % 4;
+                    Action required = delta == 0 ? Action::FW : delta == 3 ? Action::CCR : Action::CR;
+                    if (a != required) { valid = false; break; }
+                }
+                const int to = a == Action::FW ? sequence_neighbors_[cell][orientation] : cell;
+                if (to < 0 || !cert_.core[to] || !allowed(i, to) || witness_cell[to]) { valid = false; break; }
+                path.cells[t] = to;
+                path.orientations[t] = (orientation + (a == Action::CR ? 1 : a == Action::CCR ? 3 : 0)) % 4;
+                if (to == commitment) commitment = -1;
+            }
+            if (!valid) continue;
+            score(path);
+            // Prepare a strictly better stationary orientation before bounded
+            // repair. Its cells equal the waiting seed at every time, so this
+            // cannot disturb any other initial reservation. Mode 1 only adds
+            // turn candidates; mode 2 also guarantees their consideration here.
+            if (sequence_turn_only_ == 2 && baseline.actions[0] == Action::W && stationary &&
+                k >= pool.size() - 3 && path.cost < choices[i][0].cost) {
+                choices[i][0] = path;
+                stationary_seed[i] = true;
+            }
+            choices[i].push_back(path);
+        }
+    }
+    ActionSequenceSearch search(static_cast<int>(cert_.free.size()), horizon, choices, fixed, sequence_blockers_, sequence_budget_, sequence_depth_,
+                                sequence_temperature_, sequence_seed_ + uint32_t(env_->curr_timestep) * 0x9e3779b9U);
+    search.run(order_, sequence_passes_, [&] { check_deadline(deadline_, "sequence_repair"); });
+    // Replay-validate every layer before publishing the first joint action.
+    std::vector<int> owners(cert_.free.size(), -1);
+    for (int t = 1; t <= horizon; ++t) {
+        for (int i = 0; i < n_; ++i) {
+            const auto& p = search.path(i);
+            int v = p.cells[t];
+            if (v < 0 || v >= static_cast<int>(cert_.free.size()) || !cert_.free[v] || owners[v] >= 0)
+                throw std::logic_error("invalid sequence vertex");
+            owners[v] = i;
+        }
+        for (int i = 0; i < n_; ++i) {
+            const auto& p = search.path(i);
+            if (p.cells[t - 1] == p.cells[t]) continue;
+            int other = owners[p.cells[t - 1]];
+            if (other >= 0 && search.path(other).cells[t - 1] == p.cells[t])
+                throw std::logic_error("invalid sequence edge swap");
+        }
+        for (int i = 0; i < n_; ++i) owners[search.path(i).cells[t]] = -1;
+    }
+    check_deadline(deadline_, "sequence_complete");
+    if (sequence_carry_) {
+        sequence_previous_.resize(n_);
+        for (int i = 0; i < n_; ++i) sequence_previous_[i] = search.path(i);
+        sequence_last_step_ = env_->curr_timestep;
+    }
+    for (int i = 0; i < n_; ++i) {
+        if (search.selected(i) == 0 && (fixed[i] || (!sequence_carry_ && !sequence_initial_wait_ && !stationary_seed[i]))) continue;
+        const auto& path = search.path(i);
+        int target = commitments[i];
+        for (int t = 1; t <= horizon; ++t) if (path.cells[t] != loc_[i]) { target = path.cells[t]; break; }
+        // A future visit after an initial wait is not a turn/move in progress.
+        // Retain an existing commitment, but do not acquire a new immediate
+        // reservation for a cell that this robot has not started to enter.
+        if (commitments[i] < 0 && target >= 0 && path.actions[0] == Action::W) {
+            ++stats_.sequence_future_commitments;
+            if (sequence_defer_commitment_) {
+                target = -1;
+                ++stats_.sequence_deferred_commitments;
+            }
+        }
+        if (agents_[i].committed != target) agents_[i].commit_age = 0;
+        agents_[i].committed = target;
+        next_[i] = target < 0 ? loc_[i] : target;
+        actions[i] = path.actions[0];
+        stats_.sequence_changed_actions += actions[i] != baseline_actions[i];
+    }
+    ++stats_.sequence_calls;
+    stats_.sequence_attempts += search.attempts;
+    stats_.sequence_improvements += search.improvements;
+    stats_.sequence_explorations += search.explorations;
+    stats_.sequence_rollbacks += search.rollbacks;
+    stats_.sequence_candidates += search.candidates;
+    stats_.sequence_displacements += search.displacements;
 }
 
