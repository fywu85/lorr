+  setenv("CGAR_SEQUENCE_FREE_INTENTS",policy?"1":"0",1);
+  setenv("CGAR_SEQUENCE_INITIAL_WAIT",policy==2?"1":"0",1);
+  setenv("CGAR_SEQUENCE_BLOCKERS",std::to_string(blockers).c_str(),1);
+  setenv("CGAR_SEQUENCE_DEFER_COMMITMENT",std::to_string(defer).c_str(),1);
+  setenv("CGAR_SEQUENCE_HORIZON",std::to_string(h).c_str(),1);
+  pocket_case();pocket_case(20);persistent_primary();capacity_bootstrap();reassignment_recovery_protection();
+ }
