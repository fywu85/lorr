+#pragma once
+#include "ActionModel.h"
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <stdexcept>
+#include <vector>
+
+namespace cgar {
+
+constexpr int kSequenceMaxHorizon = 5;
+struct ActionSequence {
+    std::array<int, kSequenceMaxHorizon + 1> cells{};
+    std::array<int, kSequenceMaxHorizon + 1> orientations{};
+    std::array<Action, kSequenceMaxHorizon> actions{};
+    int64_t cost = 0;
+};
+
+// Bounded displacement-chain search over COMPLETE, jointly feasible trajectories.
+// The initial trajectory for each robot is choice zero. A failed repair restores
+// every reservation; a successful repair strictly reduces the summed path cost.
+// Deadline checks are supplied by CGAR and throw, never accepting partial work.
+class ActionSequenceSearch {
+public:
+    ActionSequenceSearch(int cells, int horizon, const std::vector<std::vector<ActionSequence>>& choices,
+                         const std::vector<char>& fixed)
+        : horizon_(horizon), choices_(choices), fixed_(fixed), selected_(choices.size(), 0),
+          owners_(cells * horizon, -1), visiting_(choices.size(), false), cells_(cells) {
+        if (horizon < 1 || horizon > kSequenceMaxHorizon || choices.size() != fixed.size())
+            throw std::invalid_argument("invalid action-sequence search dimensions");
+        for (size_t i = 0; i < choices.size(); ++i) {
+            if (choices[i].empty() || conflict(choices[i][0]) != -1)
+                throw std::logic_error("invalid initial joint action sequences");
+            add(static_cast<int>(i));
+        }
+        ordered_.resize(choices.size());
+        for (size_t i = 0; i < choices.size(); ++i) {
+            auto& ids = ordered_[i];
+            for (size_t k = 0; k < choices[i].size(); ++k) ids.push_back(static_cast<int>(k));
+            std::stable_sort(ids.begin(), ids.end(), [&](int a, int b) { return choices[i][a].cost < choices[i][b].cost; });
+        }
+    }
+
+    template<class Check>
+    void run(const std::vector<int>& order, int passes, Check check) {
+        for (int pass = 0; pass < passes; ++pass) for (int robot : order) {
+            check();
+            if (fixed_[robot]) continue;
+            ++attempts;
+            remove(robot);
+            int budget = 64;
+            if (repair(robot, 0, budget, 0, check)) ++improvements;
+            else { add(robot); ++rollbacks; }
+        }
+        check();
+    }
+
+    const ActionSequence& path(int robot) const { return choices_[robot][selected_[robot]]; }
+    int selected(int robot) const { return selected_[robot]; }
+    long long attempts = 0, improvements = 0, rollbacks = 0, candidates = 0, displacements = 0;
+
+private:
+    // -1: free, -2: multiple distinct blockers; otherwise a single robot.
+    int conflict(const ActionSequence& path) const {
+        int blocker = -1;
+        auto observe = [&](int robot) {
+            if (robot < 0) return true;
+            if (blocker >= 0 && blocker != robot) return false;
+            blocker = robot; return true;
+        };
+        for (int t = 1; t <= horizon_; ++t) {
+            const int from = path.cells[t - 1], to = path.cells[t];
+            if (from < 0 || to < 0 || from >= cells_ || to >= cells_)
+                throw std::logic_error("action-sequence cell outside the map");
+            if (!observe(owners_[(t - 1) * cells_ + to])) return -2;
+            if (from != to) {
+                const int other = owners_[(t - 1) * cells_ + from];
+                if (other >= 0 && this->path(other).cells[t - 1] == to && !observe(other)) return -2;
+            }
+        }
+        return blocker;
+    }
+    void add(int robot) {
+        const auto& p = path(robot);
+        for (int t = 1; t <= horizon_; ++t) {
+            int& owner = owners_[(t - 1) * cells_ + p.cells[t]];
+            if (owner >= 0) throw std::logic_error("duplicate sequence reservation");
+            owner = robot;
+        }
+    }
+    void remove(int robot) {
+        const auto& p = path(robot);
+        for (int t = 1; t <= horizon_; ++t) {
+            int& owner = owners_[(t - 1) * cells_ + p.cells[t]];
+            if (owner != robot) throw std::logic_error("missing sequence reservation");
+            owner = -1;
+        }
+    }
+    template<class Check>
+    bool repair(int robot, int depth, int& budget, int64_t delta, Check& check) {
+        visiting_[robot] = true;
+        const int old = selected_[robot];
+        const int64_t old_cost = path(robot).cost;
+        for (int choice : ordered_[robot]) {
+            if (budget-- <= 0) break;
+            ++candidates;
+            if ((candidates & 63) == 0) check();
+            const auto& candidate = choices_[robot][choice];
+            const int other = conflict(candidate);
+            if (other == -2 || (other >= 0 && (depth == 4 || fixed_[other] || visiting_[other]))) continue;
+            const int64_t change = delta + candidate.cost - old_cost;
+            if (other < 0) {
+                if (change >= 0) continue;
+                selected_[robot] = choice; add(robot);
+                visiting_[robot] = false; return true;
+            }
+            remove(other);
+            selected_[robot] = choice; add(robot);
+            ++displacements;
+            if (repair(other, depth + 1, budget, change, check)) {
+                visiting_[robot] = false; return true;
+            }
+            remove(robot); selected_[robot] = old;
+            add(other);
+        }
+        selected_[robot] = old;
+        visiting_[robot] = false;
+        return false;
+    }
+    int horizon_;
+    const std::vector<std::vector<ActionSequence>>& choices_;
+    const std::vector<char>& fixed_;
+    std::vector<int> selected_, owners_;
+    std::vector<char> visiting_;
+    int cells_;
+    std::vector<std::vector<int>> ordered_;
+};
+
+}  // namespace cgar
