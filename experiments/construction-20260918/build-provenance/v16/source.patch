+ unsetenv("CGAR_TEMPORAL_DISTANCE_SCALE");
+ std::cout<<"TEMPORAL_DISTANCE_SCALE passed dominance_pairs="<<checked<<" native_tie_term=1 protected_progress=1 threaded_replay=1\n";
+}
