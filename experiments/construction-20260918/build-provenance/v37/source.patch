+        for (size_t pos = 0; pos < queue.size() && pos < node_limit && considered < local_limit; ++pos) {
+            if ((pos & 63) == 0) check_deadline(deadline_, "pool_exchange_search");
+            const int cell = queue[pos], distance = distances[cell];
