+    }
+
+    // Read only complete cached tables: no speculative table construction,
+    // partial BFS chain estimates, mixed Manhattan scores or LRU promotion.
+    std::unordered_map<int, int> chains;
+    auto chain = [&](int id) {
+        const auto found = chains.find(id);
