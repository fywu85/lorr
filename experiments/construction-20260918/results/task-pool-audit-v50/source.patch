+        json snapshot = {{"step", at}};
+        for (size_t k = 0; k < names.size(); ++k)
+            snapshot[names[k]] = {{"chain", distribution(chains[k])}, {"age", distribution(ages[k])}};
+        report["pool_snapshots"].push_back(snapshot);
+        if (at == horizon) break;
+    }
