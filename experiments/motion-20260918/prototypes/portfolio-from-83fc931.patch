+std::vector<std::array<int, 4>> Cgar::proposal_scores() const {
+    std::vector<std::array<int, 4>> scores(n_);
+    for (int i = 0; i < n_; ++i) {
+        check_deadline(deadline_, "proposal_scoring");
+        const int goal = agents_[i].goal;
+        if (goal < 0 || parked_[i]) continue;
+        // Capture one immutable distance basis before generating any proposal.
+        // No cache build, LRU promotion or RNG consumption occurs in scoring.
+        const auto* table = oracle_.peek(goal);
+        auto h = [&](int cell) {
+            const int distance = table ? oracle_.distance_from(*table, cell) : kInf;
+            return distance < kInf ? distance : oracle_.manhattan(cell, goal);
+        };
+        auto potential = [&](int cell, int orientation) {
+            const int distance = h(cell);
+            int turns = 2;
+            if (distance == 0) turns = 0;
+            for (int d = 0; d < 4; ++d) {
+                const int v = neighbor(cell, d);
+                if (v < 0 || !allowed(i, v) || h(v) >= distance) continue;
+                const int diff = (d - orientation + 4) % 4;
+                turns = std::min(turns, diff == 2 ? 2 : (diff != 0));
+            }
+            return 2 * distance + turns;
+        };
+        const int before = potential(loc_[i], ori_[i]);
+        const int forward = neighbor(loc_[i], ori_[i]);
+        scores[i][Action::FW] = forward >= 0 && cert_.free[forward] ? before - potential(forward, ori_[i]) : -kInf;
+        scores[i][Action::CR] = before - potential(loc_[i], (ori_[i] + 1) % 4);
+        scores[i][Action::CCR] = before - potential(loc_[i], (ori_[i] + 3) % 4);
+        scores[i][Action::W] = 0;
+    }
+    return scores;
+}
